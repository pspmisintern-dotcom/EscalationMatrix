# Copy to `.env` for local dev. NEVER commit `.env` (it holds secrets).
# On Render, set these as Environment Variables in the dashboard instead.
# --- Cloud AI (OpenAI, optional fast path) ---
# When set, novel causes try OpenAI FIRST, then Ollama, then the heuristic.
# Leave blank to run Ollama-only. Needs credits/quota or calls fall back.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30
# Which AI chain to use: auto (openai -> ollama -> heuristic), openai, ollama, off
AI_PROVIDER=auto
# Vercel frontend origin for CORS, e.g. https://escalation-app.vercel.app
# (Render: FRONTEND_URL; local dev needs nothing — localhost:3000 is allowed).
FRONTEND_URL=
OLLAMA_MODEL=qwen2.5:1.5b
AI_MAX_CONTEXT_CASES=1
AI_MAX_FIELD_CHARS=70
AI_NUM_PREDICT=80
AI_NUM_CTX=1024
AI_NUM_THREAD=0
AI_KEEP_ALIVE=-1
AI_FIRST_TOKEN_TIMEOUT=15
AI_TOTAL_TIMEOUT=30
AI_CACHE_SIZE=32
